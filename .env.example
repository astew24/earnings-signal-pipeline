# Copy to .env before running

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/earnings_signal

# Polygon.io API key (required for OHLCV data)
# Free tier: 5 requests/min. Starter tier: unlimited.
# Get yours at: https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key_here

# EDGAR fair-use user-agent (required by SEC — must include contact email)
EDGAR_USER_AGENT=earnings-signal-pipeline youremail@example.com

# FinBERT model (HuggingFace hub ID)
FINBERT_MODEL=ProsusAI/finbert

# spaCy model name
SPACY_MODEL=en_core_web_sm

# Device for inference: -1 = CPU, 0 = first GPU
DEVICE=-1
